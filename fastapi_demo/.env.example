# =========================
# Software Reco — Environment
# =========================
# Copy to .env and fill in real values.

# ---- server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ---- auth ----
# Leave empty for dev mode (no auth). In production, set to random >=32 char strings.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
ADMIN_API_KEY=

# ---- rate limit ----
RATE_LIMIT_RECOMMEND=30/minute

# ---- LLM ----
LLM_MODEL=qwen2.5-7b-instruct
OPENAI_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_API_KEY=LOCAL_DUMMY_KEY

# ---- multimodal vision ----
# The vision endpoint must support OpenAI-compatible chat messages containing image_url parts.
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave empty to reuse DASHSCOPE_API_KEY or OPENAI_API_KEY.
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=30
VISION_CAPTION_MAX_TOKENS=500
MULTIMODAL_MAX_IMAGES=4
MULTIMODAL_MAX_IMAGE_BYTES=5242880
MULTIMODAL_MAX_TOTAL_IMAGE_BYTES=12582912
MULTIMODAL_MAX_IMAGE_PIXELS=16777216

# ---- native image-vector retrieval (optional) ----
# Enables text-to-image and image-to-image retrieval in addition to the caption route.
RECALL_ENABLE_IMAGE_VECTOR=false
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
# Optional immutable Hugging Face model revision/commit.
IMAGE_EMBEDDING_REVISION=
IMAGE_EMBEDDING_DEVICE=cpu
# Set false for the first model download, then true for offline-only startup.
IMAGE_EMBEDDING_LOCAL_FILES_ONLY=true
IMAGE_VECTOR_COLLECTION_NAME=software_recommendations_image
RECALL_IMAGE_VECTOR_TOP_K=12
MULTIMODAL_RRF_K=60
MULTIMODAL_TEXT_VECTOR_WEIGHT=1.0
MULTIMODAL_IMAGE_VECTOR_WEIGHT=1.0

# ---- LLM fallback (DashScope) ----
DASHSCOPE_API_KEY=<your-dashscope-key>
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- embedding ----
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:18001/v1
EMBEDDING_LOCAL_API_KEY=LOCAL_DUMMY_KEY
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_ENABLE_FALLBACK=true
EMBEDDING_FALLBACK_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_TIMEOUT_SECONDS=15

# ---- TAVILY web search ----
TAVILY_API_KEY=<your-tavily-key>

# ---- LangSmith ----
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=software-reco-rag-eval

# ---- vector store ----
CHROMA_DB_PATH=./chroma_db_parent_child_v2
ENABLE_PARENT_CHILD_CHUNKING=true
INGEST_PATH=./ingest_docs

# ---- retrieval ----
TOP_K=8
RETRIEVAL_ENABLE_RERANK=true
RERANK_MODEL_ENABLED=true
RERANK_MODEL_NAME=BAAI/bge-reranker-base
RERANK_MODEL_DEVICE=cpu
RERANK_MODEL_LOCAL_FILES_ONLY=true
RERANK_MODEL_BATCH_SIZE=8
RERANK_MODEL_MAX_LENGTH=512
