# =========================
# Software Reco — Environment
# =========================
# Copy to .env and fill in real values.

# ---- server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ---- auth ----
# Service authentication is required. Use random >=32 character strings.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: load the generated .runtime/auth-demo.env during startup.
API_KEY=
ADMIN_API_KEY=

# ---- rate limit ----
RATE_LIMIT_RECOMMEND=30/minute

# ---- LLM ----
LLM_MODEL=qwen2.5-7b-instruct
OPENAI_BASE_URL=http://127.0.0.1:18000/v1
OPENAI_API_KEY=LOCAL_DUMMY_KEY

# ---- multimodal vision ----
# The vision endpoint must support OpenAI-compatible chat messages containing image_url parts.
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave empty to reuse DASHSCOPE_API_KEY or OPENAI_API_KEY.
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=30
VISION_CAPTION_MAX_TOKENS=500
MULTIMODAL_MAX_IMAGES=4
MULTIMODAL_MAX_IMAGE_BYTES=5242880
MULTIMODAL_MAX_TOTAL_IMAGE_BYTES=12582912
MULTIMODAL_MAX_IMAGE_PIXELS=16777216

# ---- native image-vector retrieval (optional) ----
# Enables text-to-image and image-to-image retrieval in addition to the caption route.
RECALL_ENABLE_IMAGE_VECTOR=false
IMAGE_EMBEDDING_MODEL=clip-ViT-B-32
# Optional immutable Hugging Face model revision/commit.
IMAGE_EMBEDDING_REVISION=
IMAGE_EMBEDDING_DEVICE=cpu
# Set false for the first model download, then true for offline-only startup.
IMAGE_EMBEDDING_LOCAL_FILES_ONLY=true
IMAGE_VECTOR_COLLECTION_NAME=software_recommendations_image
RECALL_IMAGE_VECTOR_TOP_K=12
MULTIMODAL_RRF_K=60
MULTIMODAL_TEXT_VECTOR_WEIGHT=1.0
MULTIMODAL_IMAGE_VECTOR_WEIGHT=1.0

# ---- LLM fallback (DashScope) ----
DASHSCOPE_API_KEY=<your-dashscope-key>
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- embedding ----
EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_BASE_URL=http://127.0.0.1:18001/v1
EMBEDDING_LOCAL_API_KEY=LOCAL_DUMMY_KEY
EMBEDDING_LOCAL_MODEL=BAAI/bge-small-zh
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_ENABLE_FALLBACK=true
EMBEDDING_FALLBACK_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_TIMEOUT_SECONDS=15

# ---- TAVILY web search ----
TAVILY_API_KEY=<your-tavily-key>

# ---- LangSmith ----
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=software-reco-rag-eval

# ---- vector store ----
CHUNKING_STRATEGY=structure
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Existing files are not automatically reindexed; use ingestion.rechunk --path ... --apply.
PARENT_CHUNK_SIZE=1600
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=80
CHROMA_DB_PATH=./chroma_db_parent_child_v2
ENABLE_PARENT_CHILD_CHUNKING=true
INGEST_PATH=./ingest_docs

# ---- retrieval ----
RECALL_ENABLE_WEB=true
# auto: external/freshness queries or insufficient local evidence; always: previous fan-out.
RECALL_WEB_POLICY=auto
RECALL_WEB_MIN_LOCAL_DOCS=2
RECALL_WEB_MIN_LOCAL_SCORE=0.5
SUBQUERY_MAX_CONCURRENCY=3
RECALL_ENABLE_KEYWORD=true
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=software_recommendations_keyword_v1
ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=3
TOP_K=8
RETRIEVAL_ENABLE_RERANK=true
RERANK_MODEL_ENABLED=true
RERANK_MODEL_NAME=BAAI/bge-reranker-base
RERANK_MODEL_DEVICE=cpu
RERANK_MODEL_LOCAL_FILES_ONLY=true
RERANK_MODEL_BATCH_SIZE=8
RERANK_MODEL_MAX_LENGTH=512

# ---- versioned intent routing ----
# Keep these rollout values consistent with Spring Boot. A key alone never enables live routing.
ROUTING_DEPLOYMENT_MODE=shadow
ROUTING_TRAFFIC_PERCENT=0
ROUTING_AUTO_SESSION_APPROVED=false
ROUTING_GATE_REPORT=
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.14.0
JEV_HIGH_PROBABILITY=0.90
JEV_LOW_PROBABILITY=0.60
JEV_REVIEW_CONFIDENCE=0.80
JEV_MAX_REVIEWS=3
JEV_TIMEOUT_SECONDS=8
JEV_CIRCUIT_SECONDS=30
ROUTING_SHADOW_QUEUE_CAPACITY=100
ROUTING_SHADOW_TRACE_FILE=.runtime/routing_shadow.jsonl
DYNAMIC_ROUTING_ENABLE=false
DYNAMIC_MAX_CLARIFICATIONS=2
DYNAMIC_MAX_REFINEMENTS=1
# Optional actual contract prices per million tokens. Omit until known; unknown is not free.
# JEV_INPUT_COST_PER_MILLION_USD=
# JEV_OUTPUT_COST_PER_MILLION_USD=
# ROUTING_REVIEW_INPUT_COST_PER_MILLION_USD=
# ROUTING_REVIEW_OUTPUT_COST_PER_MILLION_USD=
# General LLM prices are optional, per 1K tokens. A model map takes precedence.
# LLM_COST_PROMPT_PER_1K_USD=
# LLM_COST_COMPLETION_PER_1K_USD=
# LLM_COST_MODEL_RATES={"model-name":{"prompt_per_1k_usd":0.001,"completion_per_1k_usd":0.002}}

# ---- KB manifest ----
# Empty uses CHROMA_DB_PATH/kb_manifest.sqlite3. Back up the manifest and all retained chunks together.
KB_MANIFEST_PATH=
