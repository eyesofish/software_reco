# Copy to .runtime/routing.env to share rollout controls in start-all.ps1 or Docker Compose.
# Put JEV_API_KEY only in fastapi_demo/.env, not here.
ROUTING_DEPLOYMENT_MODE=shadow
ROUTING_AUTO_SESSION_APPROVED=false
ROUTING_TRAFFIC_PERCENT=0
DYNAMIC_ROUTING_ENABLE=false
JEV_MODEL=jev-1.14.0
# For local start-all.ps1 use an absolute host path to the evaluated report.json.
# For Compose place the report in .runtime/routing/ and use /data/routing/report.json.
ROUTING_GATE_REPORT=
