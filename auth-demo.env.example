# Prefer scripts/init_auth_demo.py; generated values live in .runtime/auth-demo.env.
# For manual configuration use fresh random secrets and 8-72 byte demo passwords.
JWT_SECRET=<random-secret-at-least-32-bytes>
AGENT_API_KEY=<random-service-key>
API_KEY=<same-value-as-AGENT_API_KEY>
DEMO_ALICE_PASSWORD=<alice-password>
DEMO_BOB_PASSWORD=<bob-password>
